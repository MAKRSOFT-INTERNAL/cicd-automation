{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageRunnerInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:DescribeInstances",
        "ec2:TerminateInstances",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageRegistrationParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/github/actions/runners/*"
    },
    {
      "Sid": "ProvisionerCanInspectLaunchTemplate",
      "Effect": "Allow",
      "Action": "ec2:DescribeLaunchTemplates",
      "Resource": "*"
    }
  ]
}
